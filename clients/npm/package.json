{
  "name": "@alexwohlbruck/portolan",
  "version": "0.3.0",
  "description": "Automatic transit line maps. Spawns the portolan engine and speaks its build API, with a typed PLNB decoder.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/alexwohlbruck/portolan.git", "directory": "clients/npm" },
  "homepage": "https://github.com/alexwohlbruck/portolan#readme",
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": { "typescript": "^5.6.0", "@types/node": "^22.0.0" },
  "optionalDependencies": {
    "@alexwohlbruck/portolan-darwin-arm64": "0.3.0",
    "@alexwohlbruck/portolan-darwin-x64": "0.3.0",
    "@alexwohlbruck/portolan-linux-arm64": "0.3.0",
    "@alexwohlbruck/portolan-linux-x64": "0.3.0",
    "@alexwohlbruck/portolan-win32-arm64": "0.3.0",
    "@alexwohlbruck/portolan-win32-x64": "0.3.0"
  }
}
