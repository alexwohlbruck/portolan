{
  "name": "@alexwohlbruck/portolan",
  "version": "0.4.0",
  "description": "Automatic transit line maps. Spawns the portolan engine and speaks its build API, with a typed PLNB decoder.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexwohlbruck/portolan.git",
    "directory": "clients/npm"
  },
  "homepage": "https://github.com/alexwohlbruck/portolan#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./plnb": {
      "types": "./dist/plnb.d.ts",
      "default": "./dist/plnb.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "style",
    "README.md"
  ],
  "preferUnplugged": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "check-publish": "node scripts/check-publish.mjs",
    "prepublishOnly": "npm run build && npm run check-publish"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
